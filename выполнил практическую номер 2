'''Даны целые положительные числа A и B (A > B). На отрезке длины A
размещено максимально возможное количество отрезков длины B (без наложений).
Используя операцию деления нацело, найти количество отрезков B, размещенных на
отрезке A.'''

while True:
    try:
        a = int(input("Введите длинну отрезка A это велечина должна быть целой и положительной: "))
        b = int(input("Введите длинну отрезка B это велечина должна быть целой и положительной B < A: "))

        if a <= 0 or b <= 0:
            print("ошибка длины отрезков они должны быть строго большо 0")

        elif a <= b:
            print("Введите корректное значение отрезков A > B ")
        else:
            break

    except ValueError:
        print("Ошибка нужно вводить только целые числа")
c = a // b
print(f"Кол-во отрезков B на отрезке A  : {c}")
